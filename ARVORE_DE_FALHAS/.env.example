# Exemplo para desenvolvimento LOCAL: substitua placeholders e senhas antes de uso compartilhado.
# Nunca versione .env nem use estas credenciais em producao.

# AWS Bedrock (obrigatorio para iniciar Settings)
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
BEDROCK_REGION=sa-east-1
# MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# PostgreSQL (host local: localhost; Compose injeta host postgres nos containers)
POSTGRES_DB=arvore_falhas
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://admin:change-me-postgres@localhost:5432/arvore_falhas

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# S3 local via RustFS (Compose configura endpoint interno http://rustfs:9000)
S3_BUCKET=plataforma-ati-sandbox
S3_REGION=sa-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_USE_PATH_STYLE=true
S3_ACCESS_KEY=rustfs-local
S3_SECRET_KEY=change-me-rustfs
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Vinculo na interface do host (localhost por seguranca)
RUSTFS_BIND_HOST=127.0.0.1

# RabbitMQ: guest tem restricao a conexoes remotas. Use usuario dedicado.
RABBITMQ_USER=arvore_app
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
AMQP_URL=amqp://arvore_app:change-me-rabbitmq@localhost:5672/

# Cognito (substituir ambos por configuracao real; ID token com audience valido)
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=sa-east-1_EXEMPLO
COGNITO_CLIENT_ID=replace-with-cognito-app-client-id
CORS_ALLOWED_ORIGINS=http://localhost:3000

# RBAC de organizacao no DynamoDB (vazio para ambiente de teste)
DYNAMODB_TABLE_ROLES=
DYNAMODB_REGION=sa-east-1

# Obrigatoria para operacoes internas de copia/exclusao
INTERNAL_API_KEY=replace-with-long-random-secret

# Parametros de processamento e exposicao
INGEST_PUBLIC_PORT=9081
STALE_JOB_MINUTES=30
MAX_UPLOAD_BYTES=52428800
